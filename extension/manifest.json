{
  "manifest_version": 3,
  "name": "CV GEN · Offres",
  "short_name": "CV GEN",
  "version": "1.0.0",
  "description": "Trouvez des offres sur LinkedIn et importez-les dans CV GEN en un clic pour adapter votre CV.",
  "icons": { "128": "icon.png", "48": "icon.png", "16": "icon.png" },
  "action": { "default_title": "CV GEN · Offres", "default_popup": "popup.html", "default_icon": { "128": "icon.png", "48": "icon.png", "16": "icon.png" } },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "activeTab", "scripting", "alarms"],
  "host_permissions": ["http://127.0.0.1/*", "https://www.linkedin.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["linkedin.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
